# The Harbinger probe is opt-in. Keep credentials out of this repository and CI.
# KOINOS_HARBINGER_RPC_URL=https://<provider>/rpc
# KOINOS_HARBINGER_PRIVATE_KEY=<dedicated-development-wallet-key>
# KOINOS_HARBINGER_CHAIN_ID=<retrieved-at-runtime; do-not-hard-code>
# Optional U1 event values; defaults are toolchain-only placeholders.
# POV_SPIKE_DID=did:plc:example
# POV_SPIKE_CID=bafyrei...
# POV_SPIKE_AT_URI=at://did:plc:example/app.bsky.feed.post/example

# Proposed public topology only. Do not add OAuth, PDS-admin, token, or key values here.
# SWARM_APP_ORIGIN=https://app.swarm.example
# SWARM_PDS_ORIGIN=https://pds.swarm-host.example
# Exact OAuth callbacks and allowed origins are an operations-gate decision, not local defaults.
