{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": { "@pov/protocol": ["packages/protocol/src/index.ts"] }
  },
  "include": ["apps/web/**/*.js", "packages/*/src/**/*.ts"]
}
